# Spring Boot backend base URL (without the /api/v1 suffix)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# OAuth Client ID from the SAME Google Cloud project the backend verifies
# tokens against — do not create a new one, ask the backend team for this.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NextAuth session JWT encryption key. Generate a fresh one per environment
# with `openssl rand -base64 32` — never reuse across dev/staging/prod.
AUTH_SECRET=
