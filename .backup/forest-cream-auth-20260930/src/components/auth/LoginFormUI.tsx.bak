"use client";

import type { FormEvent } from "react";
import Link from "next/link";
import { useState } from "react";

import { PasswordField } from "@/components/auth/PasswordField";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

export type LoginFormUIState = "idle" | "error" | "loading" | "disabled";

type LoginFormUIProps = {
  state?: LoginFormUIState;
};

export function LoginFormUI({ state = "idle" }: LoginFormUIProps) {
  const [rememberMe, setRememberMe] = useState(false);
  const isLoading = state === "loading";
  const isDisabled = state === "disabled" || isLoading;
  const hasError = state === "error";

  const preventSubmission = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
  };

  return (
    <div>
      <header>
        <h1 className="text-[clamp(2.25rem,8vw,3rem)] font-semibold leading-[1.05] tracking-[-0.055em] text-ink">
          Welcome back
        </h1>
        <p className="mt-3 max-w-[38ch] text-[15px] leading-6 text-muted">
          Sign in to continue your English learning practice.
        </p>
      </header>

      <form className="mt-9" noValidate onSubmit={preventSubmission}>
        {hasError && (
          <div
            role="alert"
            className="mb-6 rounded-[12px] border border-red-300 bg-red-50 px-4 py-3 text-sm leading-5 text-red-800 dark:border-red-900 dark:bg-red-950/60 dark:text-red-200"
          >
            Check the highlighted details and try again.
          </div>
        )}

        <div className="grid gap-2">
          <Label htmlFor="login-email">Email</Label>
          <Input
            id="login-email"
            name="email"
            type="email"
            autoComplete="email"
            placeholder="you@example.com"
            disabled={isDisabled}
            required
            aria-invalid={hasError}
            aria-describedby={hasError ? "login-email-error" : undefined}
            className="h-[52px] rounded-[12px] bg-canvas"
          />
          {hasError && (
            <p
              id="login-email-error"
              role="alert"
              className="text-sm leading-5 text-red-700 dark:text-red-300"
            >
              Enter a valid email address.
            </p>
          )}
        </div>

        <div className="mt-5">
          <PasswordField
            id="login-password"
            autoComplete="current-password"
            placeholder="Enter your password"
            disabled={isDisabled}
          />
        </div>

        <div className="mt-4 flex items-center justify-between gap-4 text-sm">
          <Label className="flex cursor-pointer items-center gap-2.5 font-normal text-muted">
            <input
              type="checkbox"
              name="remember-me"
              checked={rememberMe}
              disabled={isDisabled}
              onChange={(event) => setRememberMe(event.target.checked)}
              className="size-4 rounded border-line accent-cobalt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cobalt disabled:cursor-not-allowed disabled:opacity-50"
            />
            Remember me
          </Label>
          <button
            type="button"
            disabled={isDisabled}
            className="rounded-sm font-medium text-cobalt underline-offset-4 transition-colors hover:text-cobalt-strong hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cobalt disabled:pointer-events-none disabled:opacity-50"
          >
            Forgot password?
          </button>
        </div>

        <Button
          type="submit"
          disabled={isDisabled}
          aria-busy={isLoading}
          className="mt-7 h-[52px] w-full rounded-[12px] font-semibold shadow-[0_12px_30px_-18px_rgba(36,87,214,0.9)]"
        >
          {isLoading ? (
            <span className="flex items-center gap-2" role="status">
              <span
                aria-hidden="true"
                className="size-4 animate-spin rounded-full border-2 border-current/30 border-t-current motion-reduce:animate-none"
              />
              Signing in...
            </span>
          ) : (
            "Sign in"
          )}
        </Button>

        <div className="my-7 flex items-center gap-4">
          <span className="h-px flex-1 bg-line" aria-hidden="true" />
          <span className="text-xs font-medium text-muted">or</span>
          <span className="h-px flex-1 bg-line" aria-hidden="true" />
        </div>

        <Button
          type="button"
          variant="outline"
          disabled={isDisabled}
          className="h-[52px] w-full rounded-[12px] font-semibold"
        >
          <span
            aria-hidden="true"
            className="mr-2.5 flex size-5 items-center justify-center rounded-full border border-line text-xs font-bold text-ink"
          >
            G
          </span>
          Continue with Google
        </Button>
      </form>

      <p className="mt-8 text-center text-sm leading-6 text-muted">
        New to PawLingo?{" "}
        <Link
          href="/register"
          className="rounded-sm font-semibold text-cobalt underline-offset-4 hover:text-cobalt-strong hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cobalt"
        >
          Create an account
        </Link>
      </p>
    </div>
  );
}
